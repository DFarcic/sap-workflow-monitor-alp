{
  "_version": "1.37.0",
  "sap.app": {
    "id": "com.comporte.workflowmonitoralp.workflowmonitoralp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:alp",
      "version": "1.18.6",
      "toolsId": "1fb99bec-eaf3-4b2b-ac5b-8cf79f7152b9"
    },
    "dataSources": {
      "ZUI_WF_MONITOR_ALP_O2_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_WF_MONITOR_ALP_O2_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_WF_MONITOR_ALP_O2_VAN.xml"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_WF_MONITOR_ALP_O2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_WF_MONITOR_ALP_O2_VAN",
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZWorkflowALP-Monitor": {
          "semanticObject": "ZWorkflowALP",
          "action": "monitor",
          "title": "{{ZWorkflowALP-Monitor.flpTitle}}",
          "subTitle": "{{ZWorkflowALP-Monitor.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.96.50",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.f": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.comporte.workflowmonitoralp.workflowmonitoralp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "metadataUrlParams": {
            "sap-value-list": "none"
          }
        }
      },
      "kpi": {
        "dataSource": "mainService",
        "preload": true
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [],
      "targets": {}
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "forceGlobalRefresh": false,
      "objectPageHeaderType": "Dynamic",
      "considerAnalyticalParameters": true,
      "showDraftToggle": false
    },
    "pages": {
      "AnalyticalListPage|WorkflowMonitor": {
        "entitySet": "WorkflowMonitor",
        "component": {
          "name": "sap.suite.ui.generic.template.AnalyticalListPage",
          "list": true,
          "settings": {
            "condensedTableLayout": true,
            "showGoButtonOnFilterBar": true,
            "tableType": "ResponsiveTable",
            "qualifier": "Default",
            "autoHide": true,
            "smartVariantManagement": false,
            "defaultFilterMode": "visual",
            "defaultContentView": "charttable",
            "filterSettings": {
              "dateSettings": {
                "useDateRange": true
              }
            },
            "tableSettings": {
              "multiSelect": false
            },
            "keyPerformanceIndicators": {
              "PendingAmount": {
                "model": "kpi",
                "entitySet": "PendingAmountKPI",
                "qualifier": "PendingAmount",
                "filterable": true
              }
            }
          }
        },
        "pages": {
          "ObjectPage|WorkflowMonitor": {
            "entitySet": "WorkflowMonitor",
            "defaultLayoutTypeIfExternalNavigation": "MidColumnFullScreen",
            "component": {
              "name": "sap.suite.ui.generic.template.ObjectPage"
            },
            "pages": {
              "ObjectPage|to_ApprovalHistory": {
                "navigationProperty": "to_ApprovalHistory",
                "entitySet": "WorkflowHistory",
                "defaultLayoutTypeIfExternalNavigation": "MidColumnFullScreen",
                "component": {
                  "name": "sap.suite.ui.generic.template.ObjectPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
}
